{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug backend",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeVersion": "22",
      "runtimeArgs": ["run", "start:dev"],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "restart": true,
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"],
      "env": {
        "PORT": "3001",
        "POSTGRES_HOST": "127.0.0.1",
        "POSTGRES_PORT": "5432",
        "POSTGRES_DATABASE": "postgres",
        "POSTGRES_USER": "postgres",
        "POSTGRES_PASSWORD": "default",
        "POSTGRES_SCHEMA": "address_change",
        "OIDC_ISSUER": "https://dev.loginproxy.gov.bc.ca/auth/realms/standard",
        "OIDC_AUDIENCE": "address-change-bc-6667",
        "OIDC_JWKS_URI": "https://dev.loginproxy.gov.bc.ca/auth/realms/standard/protocol/openid-connect/certs",
        "OIDC_SUBMISSION_SCOPE": "address-change-bc-6667"
      }
    },
    {
      "name": "Debug frontend",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeVersion": "22",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/frontend",
      "console": "integratedTerminal",
      "env": {
        "PORT": "3000",
        "BACKEND_URL": "http://localhost:3001",
        "VITE_OIDC_SCOPE": "openid profile email address-change-bc-6667"
      },
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "debugWithChrome"
      }
    }
  ],
  "compounds": [
    {
      "name": "Debug full stack",
      "configurations": ["Debug backend", "Debug frontend"],
      "stopAll": true
    }
  ]
}
