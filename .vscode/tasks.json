{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start local database",
      "type": "process",
      "command": "docker",
      "args": ["compose", "up", "--detach", "database"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Run database migrations",
      "type": "process",
      "command": "docker",
      "args": ["compose", "run", "--rm", "migrations"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": ["Start local database"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Prepare local database",
      "detail": "Run once before first debug launch and after schema changes. Normal debugger restarts do not run migrations.",
      "dependsOn": ["Run database migrations"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
