# Copy this file to .env.local. Do not commit .env.local.
# The port below is the local port-forward used by DBeaver/OpenShift.
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_DATABASE=address_change
POSTGRES_SCHEMA=address_change
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=disable

PORT=3000

OIDC_ISSUER=https://dev.loginproxy.gov.bc.ca/auth/realms/standard
OIDC_AUDIENCE=address-change-bc-6667
OIDC_JWKS_URI=https://dev.loginproxy.gov.bc.ca/auth/realms/standard/protocol/openid-connect/certs
OIDC_SUBMISSION_SCOPE=address-change-bc-6667

ADDRESS_CHANGE_ENCRYPTION_KEY_ID=local-v1
# Replace with a base64-encoded random 32-byte key for local testing.
ADDRESS_CHANGE_ENCRYPTION_KEYS={"local-v1":"replace it with yr key"}
