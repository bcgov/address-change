{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "files": {
    "includes": ["src/**/*.ts", "test/**/*.ts", "!**/dist", "!**/coverage", "!**/node_modules"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100
  },
  "javascript": {
    "parser": { "unsafeParameterDecoratorsEnabled": true },
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "off" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": { "noBannedTypes": "off", "useLiteralKeys": "off" },
      "correctness": {
        "noConstructorReturn": "off",
        "noUnreachableSuper": "off",
        "noUnusedPrivateClassMembers": "off",
        "noUnusedVariables": {
          "level": "error",
          "options": { "ignoreRestSiblings": true }
        },
        "noUnusedFunctionParameters": {
          "level": "error",
          "options": { "ignoreRestSiblings": true }
        }
      },
      "style": {
        "noNonNullAssertion": "off",
        "useImportType": "off"
      },
      "suspicious": {
        "noConsole": "off",
        "noDebugger": "warn",
        "noExplicitAny": "off",
        "noEmptyBlockStatements": "off"
      }
    }
  }
}
